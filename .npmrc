engine-strict=true
# better-auth declares an OPTIONAL peer on drizzle-orm@^0.45.2, but we pin
# drizzle-orm@^0.44.x across the app. npm 7+ treats that optional-peer mismatch
# as a hard ERESOLVE failure under `npm ci` (e.g. Railway builds). Accept the
# existing resolution rather than force-bumping drizzle-orm app-wide.
legacy-peer-deps=true
