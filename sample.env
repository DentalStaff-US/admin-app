# rename to .env and put your values in
# General
# I used postgresql for the PRISMA_URL for this project 
# but you should be able to use any DB prisma supports.
# https://www.prisma.io/docs/reference/database-reference/supported-databases
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
SVELTEKIT_PORT=3000
# Good video on how to set up OAuth with Google https://www.youtube.com/watch?v=KfezTtt2GsA
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
FROM_EMAIL = 'Your email name <your-email@your-domain.com>'
# use blank values in AWS variables if you want to use SMTP
#AWS SES KEYS
AWS_ACCESS_KEY_ID= your_aws_access_key_id
AWS_SECRET_ACCESS_KEY= your_aws_secret_access_key
AWS_REGION= your-region # us-east-1
AWS_API_VERSION= your-api-version # 2010-12-01
# if AWS SES not set the SMTP will be a fallback
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=0 # use 1 for secure
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Logging — PostHog
# Same project as the candidate app and the cron service. Events from each app
# are tagged with `source: 'admin' | 'professional' | 'cron'` so they can be
# filtered downstream.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cron
# Shared between the web service and the dedicated cron service.
# CRON_SECRET signs HMACs on outbound calls and verifies them on the /api/jobs/* endpoints.
# API_URL is the base URL the cron service POSTs to. Must include the /api prefix
# because endpoints in the registry are paths under /api (e.g. /jobs/...).
CRON_SECRET=change-me
API_URL=http://localhost:3000/api

# --- Paper invoice PDF "From" (sender) block ---
# The generated paper-invoice PDF shows this as the sender. Falls back to
# COMPANY_FROM_NAME / COMPANY_*_EMAIL when unset.
INVOICE_FROM_NAME="Dental Temps Staffing Solutions"
INVOICE_FROM_EMAIL="dtss@dtstaffingsolutions.com"
INVOICE_FROM_PHONE="+1 000-000-0000"
INVOICE_FROM_STREET="123 Example St"
INVOICE_FROM_CITY_STATE_ZIP="City, ST 00000"
INVOICE_FROM_COUNTRY="United States"

# Public job board (/api/public/jobs/*) — anonymous, masked listings for the marketing site.
# Kill switch: the endpoints 404 unless this is exactly 'true' (dev included).
PUBLIC_JOB_BOARD_ENABLED=false
# Origin allowed for browser (CORS) calls. Falls back to http://localhost:4321 in dev.
PUBLIC_MARKETING_URL=https://www.dtstaffingsolutions.com
# Optional. The marketing site's SSR server fetches for every visitor from one IP;
# sending this value in the `x-job-board-key` header skips the per-IP rate limit.
# Leave blank to rate-limit everyone. Never expose it to the browser.
JOB_BOARD_SERVER_KEY=
